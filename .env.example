# System Environment Variables (Copy to .env and configure values)

# ==============================================================================
# Security Notice: NEVER commit actual secrets, API keys, or credentials.
# ==============================================================================

# Application Gateway Settings
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enterprise Frontend Configuration
NEXT_PUBLIC_APP_NAME="RAGgo"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# RAGFlow Foundational Engine Integration
RAGFLOW_API_BASE_URL=http://localhost:9380/api/v1
RAGFLOW_API_KEY=your_ragflow_api_key_here

# Core Infrastructure Services (Underlying RAGFlow Engine)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=rag_flow
MYSQL_USER=rag_flow
MYSQL_PASSWORD=replace_with_strong_password

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=ragflow-documents

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

# Vector & Document Engine (infinity or elasticsearch)
DOC_ENGINE=infinity
INFINITY_HOST=localhost
INFINITY_PORT=23817

# LLM & Embedding Providers (Cloud / Local)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
